# ⚠️ 这是一个模板文件，请勿在此填入真实密钥！
#
# 本项目的密钥通过「系统环境变量」配置，不需要这个文件也能运行。
#
# ============================================================
#  需要配置的两个变量
# ============================================================
#
# 1) REPLICATE_API_TOKEN —— 用于「一键去除图片背景」
#    获取地址：https://replicate.com/account/api-tokens
#
# 2) OPENROUTER_API_KEY —— 用于「文字生成图片」
#    获取地址：https://openrouter.ai/settings/keys
#
# ============================================================
#  Windows 配置方式（永久生效，需重开终端）
# ============================================================
#     setx REPLICATE_API_TOKEN "你的Replicate Token"
#     setx OPENROUTER_API_KEY "你的OpenRouter Key"
#
#  macOS / Linux
#     echo 'export REPLICATE_API_TOKEN="你的Token"' >> ~/.bashrc
#     echo 'export OPENROUTER_API_KEY="你的Key"'    >> ~/.bashrc
#     source ~/.bashrc
#
# ============================================================
#  可选配置
# ============================================================
#
# 文生图模型（不配则默认 openai/gpt-5.4-image-2）
#     setx OPENROUTER_IMAGE_MODEL "google/gemini-2.5-flash-image"
#
# 文生图超时毫秒数（不配则默认 180000）
#     setx OPENROUTER_TIMEOUT_MS "180000"
#
# 服务端口（不配则默认 3000）
#     setx PORT "3000"
#
# ============================================================
#  备选做法：把本文件复制为 .env 并填写（.env 已被 .gitignore 排除）
#     cp .env.example .env
#  注意：系统环境变量的优先级高于 .env 文件
# ============================================================

REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=

# 可选
OPENROUTER_IMAGE_MODEL=
OPENROUTER_TIMEOUT_MS=
PORT=3000
